{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node", "@cloudflare/workers-types"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "boot",
    "scripts",
    "test",
    "node_modules/@vattr/toybox/test/workerd-package.d.ts"
  ]
}
