{
  "extends": [
    "airbnb-base"
  ],
  "env": {
    "es6": true
  },
  "rules": {
    "quotes": [
      "error",
      "single",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": true
      }
    ],
    "comma-dangle": ["error", "always-multiline"],
    "no-console": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-undef": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allowAfterThis": false,
        "allowAfterSuper": false,
        "enforceInMethodNames": false,
        "allow": ["_testDoGet", "_testCreateJsonResponse"]
      }
    ]
  }
}